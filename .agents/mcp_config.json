{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "video-to-prompts": {
      "command": "node",
      "args": [
        "--experimental-strip-types",
        "./electron/mcpServer.ts"
      ]
    }
  }
}
